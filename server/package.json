{
  "version": "0.0.1-main.2",
  "scripts": {
    "start": "node -r @nitrogql/esbuild-register src/main.ts",
    "test": "node -r @nitrogql/esbuild-register --test test/*.test.ts",
    "build": "esbuild --bundle --format=esm --platform=node --outfile=out/index.mjs src/main.ts --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "fmt": "prettier --write ."
  },
  "prettier": {
    "tabWidth": 4
  },
  "dependencies": {
    "@nitrogql/esbuild-register": "^1.7.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "redis": "^6.2.0",
    "ws": "^8.21.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6"
  },
  "type": "module"
}
