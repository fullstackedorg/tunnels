{
    "version": "0.0.1-main.14",
    "scripts": {
        "start": "node src/main.ts",
        "test": "node --test test/*.test.ts",
        "build": "esbuild --bundle --format=esm --platform=node --outfile=dist/index.mjs src/main.ts --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
        "fmt": "node version.ts && prettier --write ."
    },
    "prettier": {
        "tabWidth": 4
    },
    "dependencies": {
        "drizzle-orm": "^0.45.2",
        "pg": "^8.23.0",
        "redis": "^6.2.1",
        "ws": "^8.21.3"
    },
    "allowScripts": {
        "esbuild": true
    },
    "devDependencies": {
        "@types/node": "^26.4.0",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.31.10",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.6"
    },
    "type": "module"
}
